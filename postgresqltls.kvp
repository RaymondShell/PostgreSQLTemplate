Meta.DisplayName=PostgreSQL TLS
Meta.Description=PostgreSQL service compiled with OpenSSL and deny-by-default remote TLS access
Meta.OS=Linux
Meta.AarchSupport=Native
Meta.Arch=All
Meta.Author=RaymondShell; Greelan
Meta.URL=https://www.postgresql.org/
Meta.DisplayImageSource=url:https://download.logo.wine/logo/PostgreSQL/PostgreSQL-Logo.wine.png
Meta.EndpointURIFormat=
Meta.ConfigManifest=postgresqltlsconfig.json
Meta.MetaConfigManifest=postgresqltlsmetaconfig.json
Meta.ConfigRoot=postgresqltls.kvp
Meta.MinAMPVersion=2.6.2.6
Meta.SpecificDockerImage=cubecoders/ampbase:postgresql@sha256:d2c1603cf6f5d9c5a79fb3aaef9c80f0dc7be1160d529e95ee0c7c7578482ee9
Meta.DockerRequired=True
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=RequiredOnLinux
Meta.ContainerPolicyReason=Pins the reviewed AMP PostgreSQL dependency image and isolates the source build.
Meta.ExtraSetupStepsURI=
Meta.Prerequsites=[]
Meta.ExtraContainerPackages=[]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=3
Meta.ReleaseNotes=Adds an OpenSSL build, source checksum validation and TLS-only remote access defaults.
Meta.BreakingReleaseNotes=Linux only. Remote access stays disabled until an exact role, database, CIDR and valid certificate are configured.
Meta.AppConfigId=9141a92f-4e36-4295-a5b2-62321a1f13f0
Meta.ImportableExtensions=[]
Meta.AppIsMultiIPAware=False
App.DisplayName=PostgreSQL TLS
App.RootDir=./postgresql/
App.BaseDirectory=./postgresql/
App.ExecutableWin=
App.ExecutableLinux=pgsql/bin/psql
App.WorkingDir=
App.LinuxCommandLineArgs=--host={{$FullBaseDir}}run
App.WindowsCommandLineArgs=
App.CommandLineArgs={{CustomClientOptions}} {{$PlatformArgs}} --username=amp --pset=pager=off {{$FormattedArgs}}
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={"PATH":"{{$FullBaseDir}}pgsql/bin:%PATH%","MANPATH":"{{$FullBaseDir}}pgsql/share/man","LD_LIBRARY_PATH":"{{$FullBaseDir}}pgsql/lib:%LD_LIBRARY_PATH%","PGDATA":"{{$FullBaseDir}}data","PGPORT":"{{$ServerPort}}","HM_PG_BASE_DIR":"{{$FullBaseDir}}","HM_PG_LISTEN_ADDRESS":"{{$ApplicationIPBinding}}","HM_PG_RELEASE":"{{ServerVersion}}","HM_PG_VERSION":"{{CustomServerVersion}}","HM_PG_SOURCE_SHA256":"{{PostgreSQLSourceSha256}}","HM_PG_ALLOWED_DATABASE":"{{AllowedDatabase}}","HM_PG_ALLOWED_ROLE":"{{AllowedRole}}","HM_PG_ALLOWED_IPV4_CIDR":"{{AllowedIPv4CIDR}}","HM_PG_ALLOWED_IPV6_CIDR":"{{AllowedIPv6CIDR}}","HM_PG_TLS_HOSTNAME":"{{TLSHostname}}"}
App.CommandLineParameterFormat=--{0}={1}
App.CommandLineParameterDelimiter= 
App.ExitMethod=String
App.ExitTimeout=15
App.ExitString=\\! pg_ctl stop -m fast
App.ExitFile=app_exit.lck
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.UDPLogger=False
App.SupportsLiveSettingsChanges=False
App.LiveSettingChangeCommandFormat=set {0} "{1}"
App.ForceIPBinding=False
App.SupportsIPv6=True
App.ApplicationIPBinding=0.0.0.0
App.Ports=@IncludeJson[postgresqltlsports.json]
App.AdminPortRef=0
App.PrimaryApplicationPortRef=ServerPort
App.UniversalSleepApplicationUDPPortRef=0
App.MaxUsers=0
App.UseRandomAdminPassword=False
App.PersistRandomPassword=False
App.RemoteAdminPassword=
App.AdminMethod=STDIO
App.IgnoreSTDOUTAfterRCON=False
App.AdminLoginTransform=None
App.RCONConnectDelaySeconds=5
App.RCONConnectRetrySeconds=5
App.RCONHeartbeatMinutes=0
App.UpdateSources=@IncludeJson[postgresqltlsupdates.json]
App.PreStartStages=@IncludeJson[postgresqltlsstart.json]
App.UserActions=[]
App.ForceUpdate=False
App.ForceUpdateReason=
App.Compatibility=LinuxBufferedConsole
App.SmartExcludeExemptions=["*.cfg","*.conf","*.config","*.ini","*.json","*.xml","*.properties","*.kvp","*.yml","*.yaml","*.toml"]
App.SmartExcludeSupported=True
App.DumpFullChildProcessTree=False
App.MonitorChildProcessName=
App.MonitorDirectChildOnly=False
App.SupportsUniversalSleep=False
App.WakeupMode=Any
App.ApplicationReadyMode=RegexMatch
Console.FilterMatchRegex=\\e\\[(\\d+;)*(\\d+)?[ABCDHJKfmsu]|\\e\\[?[?\\>\\=\\da-z]+
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=
Console.AppReadyRegex=^(Type "help" for help\\.|CPID: \\d+)$
Console.UserJoinRegex=^$
Console.UserLeaveRegex=^$
Console.UserChatRegex=^$
Console.UpdateAvailableRegex=^$
Console.MetricsRegex=
Console.SuppressLogAtStart=False
Console.ActivateLogRegex=
Console.UserActions={}
Limits.SleepMode=True
Limits.SleepOnStart=False
Limits.SleepDelayMinutes=5
Limits.DozeDelay=2
Limits.AutoRetryCount=2
